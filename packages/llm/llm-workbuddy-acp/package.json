{
  "name": "@deepseek-ai/dsh-llm-workbuddy-acp",
  "description": "Local WorkBuddy bundled CLI persistent ACP LLM provider adapter and native ACP subagent bridge for DeepSeek Harness",
  "version": "0.2.3-alpha.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./bin/*": "./bin/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/stdio-bridge.mjs",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-subagent-acp": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*"
  }
}
